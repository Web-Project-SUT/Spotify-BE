# Spotify-BE environment. Copy to `.env` and adjust. `.env` is gitignored.
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me-in-prod
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# PostgreSQL is REQUIRED (the catalog uses a Postgres ArrayField).
# Format: postgres://USER[:PASSWORD]@HOST:PORT/DBNAME
DATABASE_URL=postgres://localhost:5432/spotify_be

# Frontend origins allowed to call this API (CORS).
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Where the payment callback redirects the browser after Zarinpal.
FRONTEND_URL=http://localhost:3000

# Zarinpal payment gateway (sandbox by default; merchant_id can be any UUID
# in the sandbox). Override for production.
ZARINPAL_MERCHANT_ID=c8d2f8b6-07c1-496c-9f4c-f8e8afae1955
ZARINPAL_BASE_URL=https://sandbox.zarinpal.com/pg

# Optional upload size caps (bytes).
# MEDIA_IMAGE_MAX_BYTES=5242880
# MEDIA_AUDIO_MAX_BYTES=52428800
